# Local demo works without this file. Use Node 22.16+.
HOST=127.0.0.1
PORT=3400
# Set both before exposing the server beyond loopback. Terminate HTTPS at your proxy.
# ADMIN_TOKEN=at-least-32-random-characters
# DATA_SECRET=at-least-32-random-characters
# PUBLIC_BASE_URL=https://leads.yourdomain.com
# Set to your proxy's exact socket IP, never a wildcard. Reads ONLY X-Real-IP.
# TRUSTED_PROXY_IP=127.0.0.1
DATA_DIR=.data
# Licensed provider gateway; see README for the normalized request/response contract.
# IDENTITY_URL=https://your-private-gateway.example/resolve
# IDENTITY_KEY=
# IDENTITY_PROVIDER_NAME=Licensed provider
# VALIDATION_URL=https://your-private-gateway.example/validate
# VALIDATION_KEY=
# OUTREACH_URL=https://your-private-gateway.example/deliver
# OUTREACH_KEY=
ENABLE_DELIVERY=false
# Live delivery requires a sender's valid postal address.
# SENDER_POSTAL_ADDRESS=
RETENTION_DAYS=90
